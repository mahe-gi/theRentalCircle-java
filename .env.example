# RentalCircle — Development Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# WARNING: NEVER COMMIT SENSITIVE OR PRODUCTION SECRETS TO VERSION CONTROL

# Database (PostgreSQL)
POSTGRES_DB=dev_platform
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_insecure_password_replace_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend (Spring Boot)
SPRING_PROFILES_ACTIVE=dev
# In development, use any 256-bit secret string (min 32 characters)
JWT_SECRET=dev_jwt_secret_key_minimum_32_characters_for_local_testing_only!
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000
FILE_UPLOAD_DIR=/var/app/uploads
FILE_SECURE_DOCS_DIR=/var/app/secure-docs

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
# Optional: Provide Google Maps API key (or configure in-app via UI)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

